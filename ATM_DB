    // Insert transaction into ministatement table
    void insertTransaction(String type, double amount) {
        try {
        	String query = "INSERT INTO ministatement (transaction_time, amount, transaction_type) VALUES (?, ?, ?)";
        	PreparedStatement ps = con.prepareStatement(query);

        	// Convert LocalDateTime to LocalDate and then to java.sql.Date to keep only the date part
        	java.sql.Date sqlDate = java.sql.Date.valueOf(LocalDateTime.now().toLocalDate());

        	ps.setDate(1, sqlDate); // Set only the date part
        	ps.setDouble(2, amount);
        	ps.setString(3, type);

           
            ps.executeUpdate();
        } catch (SQLException e) {
            System.out.println("Error inserting transaction: " + e.getMessage());
        }
    }

    // Print last 5 transactions from database
    void printMiniStatement() {
        System.out.println("=================================================");
        System.out.println("\t\tWelcome to ICICI Bank");
        System.out.println("--------------------------------------------------");
        dateTime();
        System.out.println("--------------------------------------------------");
        System.out.println("\t\tMini Statement");
        System.out.println(" ");
        try {
            String query = "SELECT transaction_time, amount, transaction_type FROM ministatement ORDER BY transaction_time DESC LIMIT 5";
            PreparedStatement ps = con.prepareStatement(query);
            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                Timestamp timestamp = rs.getTimestamp("transaction_time");
                // Convert to LocalDate to keep only the date part
                LocalDate dateOnly = timestamp.toLocalDateTime().toLocalDate();
                
                // Format the date as dd-MM-yyyy if needed
                String formattedDate = dateOnly.format(DateTimeFormatter.ofPattern("dd-MM-yyyy"));
                
                System.out.println(formattedDate + " : " + rs.getDouble("amount") + " on " + rs.getString("transaction_type"));
                System.out.println();
            }

            System.out.println(" ");
            System.out.println("------ Thank you for banking with ICICI ------");
            System.out.println(" ");
        } catch (SQLException e) {
            System.out.println("Error fetching mini statement: " + e.getMessage());
        }
       // System.out.println("=================================================");
    }

