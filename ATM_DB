    String loadPin() {
        try {
            String query = "SELECT pin FROM account_balance";
            PreparedStatement ps = con.prepareStatement(query);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) {
                return rs.getString("pin");
            }
        } catch (SQLException e) {
            System.out.println("Error loading PIN: " + e.getMessage());
        }
        return null;
    }


    
    void loadBalance() {
        try {
            String query = "SELECT balance FROM account_balance";
            PreparedStatement ps = con.prepareStatement(query);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) {
                balance = rs.getDouble("balance");
            }
        } catch (SQLException e) {
            System.out.println("Error loading balance: " + e.getMessage());
        }
    }

    void updateBalance() {
        try {
            String query = "UPDATE account_balance SET balance = ? WHERE id = 1";
            PreparedStatement ps = con.prepareStatement(query);
            ps.setDouble(1, balance);
           // ps.executeUpdate();
            int rowsUpdated = ps.executeUpdate();
           // System.out.println("Rows updated: " + rowsUpdated);
            if (rowsUpdated == 0) {
                System.out.println("Warning: No rows updated, check your WHERE clause and table state.");
            }

        } catch (SQLException e) {
            System.out.println("Error updating balance: " + e.getMessage());
        }
    }


    


